{
  "name": "mcp-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP aggregation daemon: one connection per backend, curated tool profiles, audit trail.",
  "bin": { "mcpgw": "dist/src/cli.js" },
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "validate": "npm run build --silent && node dist/src/cli.js validate",
    "test": "npm run build --silent && node --test dist/test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
